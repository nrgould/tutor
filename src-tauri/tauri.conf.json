{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eigen",
  "version": "0.1.0",
  "identifier": "com.eigen.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eigen",
        "width": 480,
        "height": 52,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "focus": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": {
        "NSScreenCaptureUsageDescription": "Eigen needs screen recording permission to capture your screen and help you study what you're working on.",
        "NSAccessibilityUsageDescription": "Eigen needs accessibility permission to respond to keyboard shortcuts from any application."
      },
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
